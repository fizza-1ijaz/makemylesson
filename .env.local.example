# Proxy /app/* to Flutter during local dev (copy to .env.local).
# Omit to proxy to production Firebase (https://makemylesson.app).
MML_FLUTTER_HOSTING_ORIGIN=http://localhost:8080

# Optional: canonical marketing site URL for metadata (defaults to https://makemylesson.ai)
# NEXT_PUBLIC_SITE_URL=https://makemylesson.ai

# Contact form email (server only — never expose SMTP_PASS to the client)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@makemylesson.ai
# SMTP_PASS=your-app-password
# SMTP_FROM="Make My Lesson <support@makemylesson.ai>"
